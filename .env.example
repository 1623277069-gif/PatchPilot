# Generate three distinct hex strings, for example with python -c 'import secrets; print(secrets.token_hex(24))'.
PATCHPILOT_DB_PASSWORD=replace_this_database_password
PATCHPILOT_ROOT_PASSWORD=replace_this_root_password
PATCHPILOT_API_TOKEN=replace_this_local_operator_token
